{
  "name": "floating-life-cards",
  "productName": "浮生牌局",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "analyze:story": "tsx scripts/analyze-story.ts",
    "analyze:prototype": "tsx scripts/analyze-prototype.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:playtest": "tsx scripts/validate-playtest-batch.ts",
    "dev": "vite",
    "lint": "oxlint",
    "judge": "node scripts/judge-server.mjs",
    "build": "tsc -b && vite build",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/package-windows.cjs",
    "desktop:make": "npm run desktop:package && node scripts/make-windows-installer.cjs",
    "mobile:sync": "node scripts/sync-native-version.cjs && npm run build && cap sync",
    "preplaytest": "npm run build",
    "playtest": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts",
    "verify:release": "npm run verify && npm run desktop:make && npm run test:desktop && npm run mobile:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.8.7",
    "electron-winstaller": "^5.4.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@electron/asar@^4.0.1": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
