{
  "name": "floating-life-cards",
  "productName": "浮生牌局",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "analyze:prototype": "tsx scripts/analyze-prototype.ts",
    "validate:playtest": "tsx scripts/validate-playtest-batch.ts",
    "dev": "vite",
    "judge": "node scripts/judge-server.mjs",
    "build": "tsc -b && vite build",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "npm run build && node_modules\\node\\bin\\node.exe scripts\\package-windows.cjs",
    "desktop:make": "npm run desktop:package && node_modules\\node\\bin\\node.exe scripts\\make-windows-installer.cjs",
    "mobile:sync": "node scripts/sync-native-version.cjs && npm run build && cap sync",
    "preplaytest": "npm run build",
    "playtest": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run test:e2e",
    "test:desktop": "playwright test --config=playwright.desktop.config.ts",
    "verify:release": "npm run verify && npm run desktop:make && npm run test:desktop && npm run mobile:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^43.4.1",
    "electron-winstaller": "^5.4.4",
    "jsdom": "latest",
    "node": "22.23.2",
    "tsx": "^4.23.12",
    "vitest": "latest"
  }
}
