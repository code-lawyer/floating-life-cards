{
  "name": "floating-life-cards",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "analyze:prototype": "tsx scripts/analyze-prototype.ts",
    "dev": "vite",
    "judge": "node scripts/judge-server.mjs",
    "build": "tsc -b && vite build",
    "preplaytest": "npm run build",
    "playtest": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "tsx": "^4.23.12",
    "vitest": "latest"
  }
}
